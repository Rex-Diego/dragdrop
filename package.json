{
  "name": "obsidian-dragdrop",
  "version": "0.1.3",
  "private": true,
  "description": "Minimal Markdown drag-and-drop workflows for Obsidian Canvas",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "npm run typecheck && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.11.3",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@eslint/js": "^9.30.0",
    "@eslint/json": "^0.12.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.30.0",
    "eslint-plugin-obsidianmd": "^0.4.0",
    "obsidian": "1.13.1",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.35.0",
    "vitest": "^4.1.10"
  }
}
